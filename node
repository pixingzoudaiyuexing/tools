#!/bin/bash

CONFIG="/etc/v2node/config.json"
SERVICE="v2node"

# 必须使用 root
if [ "$(id -u)" -ne 0 ]; then
    echo "请使用 root 用户运行此脚本"
    exit 1
fi

# 检查配置文件
if [ ! -f "$CONFIG" ]; then
    echo "未找到配置文件：$CONFIG"
    echo "请先使用 V2Board 官方一键命令安装第一个节点。"
    exit 1
fi

# 检查 python3
if ! command -v python3 >/dev/null 2>&1; then
    echo "未找到 python3，请先安装："
    echo "apt update && apt install -y python3"
    exit 1
fi

echo "=============================="
echo "      V2Node 节点管理"
echo "=============================="
echo
echo "当前节点："

python3 - "$CONFIG" <<'PY'
import json
import sys

config = sys.argv[1]

try:
    with open(config, "r", encoding="utf-8") as f:
        data = json.load(f)

    nodes = data.get("Nodes", [])

    if not nodes:
        print("无")

    for node in nodes:
        print(f"Node ID: {node.get('NodeID')}")

except Exception as e:
    print(f"读取配置失败：{e}")
    sys.exit(1)
PY

echo
echo "1. 添加节点"
echo "2. 删除节点"
echo "0. 退出"
echo

read -rp "请选择操作: " ACTION

case "$ACTION" in

    1)
        read -rp "请输入节点 ID: " NODE_ID

        if ! [[ "$NODE_ID" =~ ^[0-9]+$ ]]; then
            echo "节点 ID 必须是数字"
            exit 1
        fi

        python3 - "$CONFIG" "$NODE_ID" <<'PY'
import json
import sys
import copy

config = sys.argv[1]
node_id = int(sys.argv[2])

try:
    with open(config, "r", encoding="utf-8") as f:
        data = json.load(f)

    nodes = data.get("Nodes", [])

    if not nodes:
        print("配置中没有现有节点，无法复制配置。")
        sys.exit(1)

    for node in nodes:
        if node.get("NodeID") == node_id:
            print(f"节点 {node_id} 已存在，无需重复添加。")
            sys.exit(2)

    # 复制第一个节点的全部配置
    new_node = copy.deepcopy(nodes[0])

    # 只修改 NodeID
    new_node["NodeID"] = node_id

    nodes.append(new_node)
    data["Nodes"] = nodes

    with open(config, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=4, ensure_ascii=False)
        f.write("\n")

    print(f"节点 {node_id} 添加成功。")

except Exception as e:
    print(f"添加节点失败：{e}")
    sys.exit(1)
PY

        RESULT=$?

        if [ "$RESULT" -eq 2 ]; then
            exit 0
        elif [ "$RESULT" -ne 0 ]; then
            exit 1
        fi

        echo
        echo "正在重启 v2node..."
        systemctl restart "$SERVICE"

        if systemctl is-active --quiet "$SERVICE"; then
            echo "v2node 已正常运行。"
        else
            echo "v2node 启动异常，请查看日志："
            echo "journalctl -u v2node -n 100 --no-pager"
        fi
        ;;

    2)
        read -rp "请输入节点 ID: " NODE_ID

        if ! [[ "$NODE_ID" =~ ^[0-9]+$ ]]; then
            echo "节点 ID 必须是数字"
            exit 1
        fi

        python3 - "$CONFIG" "$NODE_ID" <<'PY'
import json
import sys

config = sys.argv[1]
node_id = int(sys.argv[2])

try:
    with open(config, "r", encoding="utf-8") as f:
        data = json.load(f)

    nodes = data.get("Nodes", [])

    found = False
    new_nodes = []

    for node in nodes:
        if node.get("NodeID") == node_id:
            found = True
        else:
            new_nodes.append(node)

    if not found:
        print(f"未找到节点 {node_id}。")
        sys.exit(2)

    data["Nodes"] = new_nodes

    with open(config, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=4, ensure_ascii=False)
        f.write("\n")

    print(f"节点 {node_id} 删除成功。")

except Exception as e:
    print(f"删除节点失败：{e}")
    sys.exit(1)
PY

        RESULT=$?

        if [ "$RESULT" -eq 2 ]; then
            exit 0
        elif [ "$RESULT" -ne 0 ]; then
            exit 1
        fi

        echo
        echo "正在重启 v2node..."
        systemctl restart "$SERVICE"

        if systemctl is-active --quiet "$SERVICE"; then
            echo "v2node 已正常运行。"
        else
            echo "v2node 启动异常，请查看日志："
            echo "journalctl -u v2node -n 100 --no-pager"
        fi
        ;;

    0)
        echo "已退出"
        exit 0
        ;;

    *)
        echo "无效选项"
        exit 1
        ;;
esac